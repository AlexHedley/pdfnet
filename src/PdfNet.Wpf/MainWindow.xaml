<Window x:Class="PdfNet.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PdfNet PDF Merger"
        Icon="Assets/pdfnet-icon.ico"
        Width="720"
        Height="500"
        MinWidth="520"
        MinHeight="360"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right"
                    Width="110"
                    Height="32"
                    Margin="8,0,0,0"
                    Click="AddFiles_Click"
                    Content="Add PDFs..." />
            <Button DockPanel.Dock="Right"
                    Width="110"
                    Height="32"
                    Click="RemoveFiles_Click"
                    Content="Remove selected" />
            <TextBlock VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Text="PDF files to merge" />
        </DockPanel>

        <ListBox x:Name="FilesList"
                 Grid.Row="1"
                 SelectionMode="Extended"
                 SelectionChanged="FilesList_SelectionChanged"
                 ToolTip="Select files and use Move up or Move down to set merge order." />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="MoveUpButton"
                    Width="100"
                    Height="32"
                    IsEnabled="False"
                    Click="MoveUp_Click"
                    Content="Move up" />
            <Button x:Name="MoveDownButton"
                    Width="100"
                    Height="32"
                    Margin="8,0,0,0"
                    IsEnabled="False"
                    Click="MoveDown_Click"
                    Content="Move down" />
        </StackPanel>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Margin="0,12,0,12"
                   Foreground="DimGray"
                   Text="Add one or more PDF files." />

        <Button Grid.Row="4"
                Width="150"
                Height="38"
                HorizontalAlignment="Right"
                Click="MergeAndOpen_Click"
                Content="Merge and open" />
    </Grid>
</Window>
