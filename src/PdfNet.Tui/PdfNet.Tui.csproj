<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>PdfNet.Tui</PackageId>
    <Version>0.1.0</Version>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>pdfnet</ToolCommandName>
    <Description>An interactive terminal tool for selecting, reordering, and merging PDF documents.</Description>
    <PackageTags>pdf;merge;combine;console;terminal;dotnet-tool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfNet\PdfNet.csproj" />
  </ItemGroup>

</Project>
