{
  "metadata": [
    {
      "src": [
        {
          "src": "../src/PdfNet",
          "files": ["PdfNet.csproj"]
        }
      ],
      "dest": "api"
    },
    {
      "src": [{ "src": "../src/PdfNet.Tui", "files": ["PdfNet.Tui.csproj"] }],
      "dest": "api-tui"
    },
    {
      "src": [{ "src": "../src/PdfNet.Wpf", "files": ["PdfNet.Wpf.csproj"] }],
      "dest": "api-wpf"
    },
    {
      "src": [{ "src": "../src/PdfNet.WinForms", "files": ["PdfNet.WinForms.csproj"] }],
      "dest": "api-winforms"
    },
    {
      "src": [{ "src": "../src/PdfNet.WinUI", "files": ["PdfNet.WinUI.csproj"] }],
      "dest": "api-winui",
      "properties": {
        "WindowsAppSDKSelfContained": "false",
        "EnableDefaultApplicationDefinition": "false",
        "EnableDefaultPageItems": "false"
      }
    },
    {
      "src": [{ "src": "../src/PdfNet.Wasm", "files": ["PdfNet.Wasm.csproj"] }],
      "dest": "api-wasm"
    }
  ],
  "build": {
    "content": [
      {
        "files": ["index.md", "api-overview.md", "toc.yml", "api/**.yml",
                  "api-tui/**.yml", "api-wpf/**.yml", "api-winforms/**.yml",
                  "api-winui/**.yml", "api-wasm/**.yml"]
      }
    ],
    "resource": [
      {
        "src": "../assets/brand",
        "files": ["pdfnet-logo.svg", "pdfnet-docs-icon.svg"],
        "dest": "assets/brand"
      }
    ],
    "dest": "../artifacts/documentation/docs",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appTitle": "PdfNet API",
      "_appLogoPath": "assets/brand/pdfnet-logo.svg",
      "_appFaviconPath": "assets/brand/pdfnet-docs-icon.svg",
      "_appFooter": "PdfNet PDF tools &middot; <a href=\"https://github.com/alexhedley/pdfnet\">Source on GitHub</a> &middot; MIT licensed",
      "pdf": true,
      "pdfFooterTemplate": "<div style=\"width:100%;font-size:10px;padding:0 2em;\">PdfNet API &middot; MIT licensed <span style=\"float:right;\"><span class=\"pageNumber\"></span> / <span class=\"totalPages\"></span></span></div>",
      "_enableSearch": true
    }
  }
}
